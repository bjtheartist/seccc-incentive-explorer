{
  "manifest_version": 3,
  "name": "Chicago Incentive Explorer — Incentive Check",
  "version": "1.0.0",
  "description": "Check which Chicago incentive zones cover an address and see the top matching programs, from the toolbar or a Cook County Assessor PIN page.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chicagoincentiveexplorer.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Incentive Check",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "privacy.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.cookcountyassessor.com/pin/*",
        "https://www.cookcountyassessoril.gov/pin/*"
      ],
      "js": [
        "lookup.js",
        "site-parsers.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
