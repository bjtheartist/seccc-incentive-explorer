# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# video (Remotion project, large)
/video

# raw / processed data (AirDropped source files — large, not for git)
/data/raw/
/data/processed/
/data/exports/
!/data/exports/
!/data/exports/chicago-neighborhood-economics/
/data/exports/chicago-neighborhood-economics/*
