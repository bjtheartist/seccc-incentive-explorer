# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
.playwright-cli/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.archive/
/.agents/
/.claude/
/.mcp.json
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# video (Remotion project, large)
/video

# generated PDF previews (scripts/preview-report-pdf.ts, scripts/smoke-report.ts)
/output/

# raw / processed data (AirDropped source files — large, not for git)
/data/raw/
/data/processed/
/data/exports/
!/data/exports/
!/data/exports/chicago-neighborhood-economics/
/data/exports/chicago-neighborhood-economics/*
!/data/exports/chicago-neighborhood-economics/neighborhood_economics_by_zip.json
!/data/exports/chicago-neighborhood-economics/neighborhood_economics_by_zip.csv
!/data/exports/chicago-neighborhood-economics/neighborhood_anchors_by_community_area.json
!/data/exports/chicago-neighborhood-economics/local_business_support_by_community_area.json
!/data/exports/chicago-neighborhood-economics/README-anchors.md
!/data/exports/southeast-resilience/
/data/exports/southeast-resilience/*
!/data/exports/southeast-resilience/neighborhood_growth_signal.json

# Site Shortlist canonical universe (scripts/export-shortlist-universe.ts,
# lib/shortlist-universe.ts) — server-only, all nine committed pilot-ZIP
# files + the shared manifest that binds them (and vacancy-index.json) under
# one buildId. NOT under public/ (see next.config.ts outputFileTracingIncludes).
!/data/exports/shortlist-universe/
/data/exports/shortlist-universe/*
!/data/exports/shortlist-universe/manifest.json
!/data/exports/shortlist-universe/60617.json
!/data/exports/shortlist-universe/60619.json
!/data/exports/shortlist-universe/60621.json
!/data/exports/shortlist-universe/60623.json
!/data/exports/shortlist-universe/60624.json
!/data/exports/shortlist-universe/60636.json
!/data/exports/shortlist-universe/60644.json
!/data/exports/shortlist-universe/60649.json
!/data/exports/shortlist-universe/60651.json
# Precomputed exact County parcel identity per universe row
# (scripts/resolve-shortlist-universe-parcels.ts, lib/shortlist-parcel-identity.ts)
# — bound to the universe buildId; the loader fails closed on any mismatch.
!/data/exports/shortlist-universe/parcel-identity/
/data/exports/shortlist-universe/parcel-identity/*
!/data/exports/shortlist-universe/parcel-identity/manifest.json
!/data/exports/shortlist-universe/parcel-identity/60617.json
!/data/exports/shortlist-universe/parcel-identity/60619.json
!/data/exports/shortlist-universe/parcel-identity/60621.json
!/data/exports/shortlist-universe/parcel-identity/60623.json
!/data/exports/shortlist-universe/parcel-identity/60624.json
!/data/exports/shortlist-universe/parcel-identity/60636.json
!/data/exports/shortlist-universe/parcel-identity/60644.json
!/data/exports/shortlist-universe/parcel-identity/60649.json
!/data/exports/shortlist-universe/parcel-identity/60651.json

# Zoning boundary snapshot (scripts/fetch-zoning-snapshot.ts) — the raw
# clipped polygon pull is disposable/regenerable and can run large; only its
# manifest (checksum, vintage, per-ZIP feature counts) is committed so the
# universe export's `sources.zoning` provenance is reviewable without
# committing the geometry itself.
!/data/exports/zoning-snapshot/
/data/exports/zoning-snapshot/*
!/data/exports/zoning-snapshot/manifest.json

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
