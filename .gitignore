# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.archive/
/.agents/
/.claude/
/.mcp.json
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
